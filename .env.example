# Copy to .env (repo root) and fill in. Both the backend and the frontend read this file.
# Only VITE_-prefixed values are exposed to the browser.

# --- Supabase (Dashboard -> Project Settings -> API) ---
# Public: safe in the browser. Row-level security limits it to reading published events.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# SECRET: backend only. Bypasses row-level security. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Backend API ---
# Where the site calls the FastAPI backend (poster extraction + submissions)
VITE_API_URL=http://localhost:8000
# Sites allowed to call the API from a browser (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5179

# --- Vision models for poster extraction ---
GROQ_API_KEY=
GEMINI_API_KEY=
